{
  "metadata": [
    {
      "src": [
        {
          "src": "../../artifacts/docs/workspace/metadata-source",
          "files": [
            "MirrorPulse.Adapter.Sdk.dll"
          ]
        }
      ],
      "dest": "../../artifacts/docs/workspace/api"
    }
  ],
  "build": {
    "content": [
      {
        "src": "../../artifacts/docs/workspace",
        "files": [
          "index.md",
          "toc.yml",
          "articles/**.md",
          "api/**.yml",
          "api/**/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "src": "../../artifacts/docs/workspace",
        "files": [
          "articles/**/{*.png,*.jpg,*.jpeg,*.gif,*.svg}"
        ]
      }
    ],
    "dest": "../../artifacts/docs/adapter",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appTitle": "MirrorPulse Adapter SDK documentation",
      "_appName": "Adapter SDK",
      "_appFooter": "Copyright © MirrorPulse Team. Licensed under Apache-2.0.",
      "_enableSearch": true
    }
  }
}
